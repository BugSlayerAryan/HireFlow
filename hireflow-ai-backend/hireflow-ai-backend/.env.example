# Database (Aiven example format; replace placeholders)
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# JWT (use a long random value, at least 32 bytes)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=86400000

# Gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash

# Optional one-time admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# Upload directory
HIREFLOW_UPLOAD_DIR=uploads
